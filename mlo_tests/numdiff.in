# Finite-difference validation of -dU/dx, -dU/dy and -dU/dz_i for lj/cut/mlo.
#
# alpha MUST be small (~5) here. At alpha = 50, Theta' is appreciable only for
# |z - z*| < 0.1, so the z-forces are numerically zero almost everywhere and the test
# becomes vacuous -- it would pass even with the lambda_max factor dropped from the
# z-force expressions entirely.
units           lj
atom_style      atomic
dimension       3
boundary        p p f
atom_modify     map array
processors      * * 1

region          box block -12 12 -12 12 -12 12
create_box      2 box
mass            * 1.0

create_atoms    1 single  0.00  0.00  -0.31
create_atoms    1 single  1.30  0.00   0.47
create_atoms    2 single  0.61  1.13   0.09
create_atoms    2 single -0.94  0.55  -0.18

pair_style      lj/cut/mlo 5.5901699437 0.0 2.5 alpha 5.0
pair_coeff      1 1  1.7  1.00  lambda 1.0
pair_coeff      2 2  0.9  0.80  lambda 0.0
pair_coeff      1 2  1.2  0.90  lambda 0.35
pair_modify     shift yes

# defined FIRST so its stored analytic forces are the pair forces alone
fix             nd all numdiff 1 1.0e-6

variable        ex atom abs(fx-f_nd[1])
variable        ey atom abs(fy-f_nd[2])
variable        ez atom abs(fz-f_nd[3])
variable        az atom abs(fz)
compute         em all reduce max v_ex v_ey v_ez v_az
thermo_style    custom step evdwl c_em[1] c_em[2] c_em[3] c_em[4]
thermo_modify   format float %.6e

variable        r index 0.80 0.95 1.00 1.05 1.12246204 1.12246205 1.20 1.40 1.80 2.30 2.49
label           rloop
  set           atom 2 x ${r}
  run           1 post no
  print         "FD r=${r} evdwl=$(evdwl:%.10e) maxerr_x=$(c_em[1]:%.3e) maxerr_y=$(c_em[2]:%.3e) maxerr_z=$(c_em[3]:%.3e) max_fz=$(c_em[4]:%.3e)"
next            r
jump            SELF rloop
