# 2D Langevin Dynamics with Energy Minimization
# z dimension: chemical reactions

# box setup
# ----------------
# -              -
# -              -
# ----------------
#
#   INITIAL_LX = 4 L_y

# --- Setting up variables ---




# read the restart file

# z is a chemical reaction coordinate, not a spatial dimension:
#   - `f` (not `p`) because a periodic image ghost carries z + Lz, so Theta(z) would
#     evaluate its chemical state at the wrong z (and a wrapped z makes Theta jump).
#   - `processors * * 1` because z must not be domain-decomposed: it is what makes the
#     pair style's |dz| budget check exact, and every atom sits near z = 0 anyway.
processors      * * 1
read_restart    after_equil.out

# The restart file was written with a periodic z. Convert it: z is a reaction coordinate,
# and a periodic image ghost carries z + Lz, so Theta(z) would read its chemical state at
# the wrong z.
change_box      all boundary p p f


variable binding_strength   equal   1.7
# variable delta_t            equal   0.0001 * sqrt(1.0/${binding_strength})
variable delta_t            equal   0.0001 * sqrt(1.0/${binding_strength})


variable z_depth    equal   20.0
variable cutoff_xy  equal   2.5
variable z_max      equal   5.0
variable cutoff     equal   sqrt(${cutoff_xy}^2 + ${z_max}^2)

variable filename   string  epsilon17

variable temp       equal   1.00
variable GAMMA      equal   100.0

#
#   This defines the external free energy landscape for the internal coordinate z
#

variable b          equal   3.06
variable s          equal   1.0
variable f          equal   1.5
variable z_star     equal   0.256

# Analysis settings: inflection points of phi(z) = s*z^4 - b*z^2 + f*z.
# Positive distances from zero: inactive z < -barrier_left, active z > barrier_right.
variable barrier_left    equal sqrt(v_b/(6*v_s))
variable barrier_right   equal sqrt(v_b/(6*v_s))
variable saving_interval equal 100



# --- Initialization ---
# units           lj
# atom_style      atomic
# dimension       3
# boundary        p p p

newton          on


# # --- System Definition ---
# region          sim_box block 0 ${4INITIAL_LY} 0 ${INITIAL_LY} -${z_depth} ${z_depth}
# region          spawn_box block 0 ${4INITIAL_LY} 0 ${INITIAL_LY} -0.5 0.5

# create_box      1 sim_box


# mass            1   1.0

# create_atoms    1 random ${N} 150699 spawn_box

# region          spawn_box_active block ${INITIAL_LY} ${3INITIAL_LY} 0 ${INITIAL_LY} 0.75 0.76
# create_atoms    1 random ${n_dense} 21022 spawn_box_active

# region          spawn_box_dilute_1 block 0 ${INITIAL_LY} 0 ${INITIAL_LY} -2.0 -1.5
# create_atoms    1 random ${h_n_dilute} 21022 spawn_box_dilute_1

# region          spawn_box_dilute_2 block ${3INITIAL_LY} ${4INITIAL_LY} 0 ${INITIAL_LY} -2.0 -1.5
# create_atoms    1 random ${h_n_dilute} 21021 spawn_box_dilute_2



pair_style      lj/cut/mlo ${cutoff} ${z_star} ${cutoff_xy} 
# pair_style      lj/cut ${cutoff}

pair_coeff      * * ${binding_strength} 1.0

#pair_style hybrid lj/cut/mlo ${cutoff} lj/cut/chemreactions ${cutoff}
#pair_coeff 1 1 lj/cut/mlo ${binding_strength} 1.0
#pair_coeff 1 2 lj/cut/mlo 0.0 1.0
#pair_coeff 2 2 lj/cut/chemreactions ${binding_strength} 1.0

neigh_modify    every 5 delay 0 check yes



# --- Langevin Dynamics Settings ---
fix             1 all nve
fix             2 all langevinMLO ${temp} ${temp} 1.0 ${GAMMA} 150699
fix             3 all free_energy ${s} ${b} ${f}


# --- Output ---
thermo          1000
thermo_style    custom step temp pe ke epair evdwl f_3
dump            1 all custom ${saving_interval} out/probing_chem_reactions_${filename}.lammpstrj id type x y z

# --- Production ---
# Initialize velocities to kBT = 1
# velocity        all create ${temp} 150688
timestep        ${delta_t}
run             100000
# run             10000

write_restart state_after_probing_chem_reactions.out

# Analyze in the MDA environment with:
# python standard_analysis.py -t out/probing_chem_reactions_epsilon17.lammpstrj @out/probing_chem_reactions_epsilon17.analysis.args
# LAMMPS resolves expressions so the analysis uses exactly the simulation values.
# One argument per line for Python argparse's @file support. Export actual run values.
print """--gamma
${GAMMA}
--epsilon
${binding_strength}
--timestep
${delta_t}
--saving_interval
${saving_interval}
--barrier_left
${barrier_left}
--barrier_right
${barrier_right}""" file out/probing_chem_reactions_${filename}.analysis.args screen no



